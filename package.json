{
  "name":"bellora","version":"1.0.0","description":"BELLORA school management system with a React frontend and Node.js backend","main":"backend/index.js","scripts":{"start":"node ./node_modules/nodemon/bin/nodemon.js backend/index.js","dev":"node backend/scripts/dev.js","server":"node ./node_modules/nodemon/bin/nodemon.js backend/index.js --watch backend","frontend":"npm.cmd --prefix frontend run serve","build":"npm --prefix frontend run build","db:migrate":"node backend/migrations/run-migrations.js","db:migrate:legacy":"node backend/migrations/fix-current-schema.js","db:seed":"node backend/migrations/seed-demo-data.js","db:reset-academic":"node backend/migrations/reset-academic-demo-data.js","install-all":"npm.cmd install && npm.cmd install --prefix frontend","start:prod":"node backend/index.js"},
  "dependencies":{"axios":"^1.15.2","bcryptjs":"^2.4.3","cors":"^2.8.5","dotenv":"^16.3.1","express":"^4.18.2","express-rate-limit":"^6.10.0","express-validator":"^7.0.1","helmet":"^7.0.0","jsonwebtoken":"^9.0.2","multer":"^1.4.5-lts.1","mysql2":"^3.22.3","resend":"^6.12.3"},"devDependencies":{"concurrently":"^8.2.0","nodemon":"^3.1.14"}
